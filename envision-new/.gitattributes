# Mark TypeScript as the primary language
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Mark JavaScript files as config/backend (not primary frontend code)
*.js linguist-language=TypeScript
eslint.config.js linguist-documentation
postcss.config.js linguist-documentation
tailwind.config.js linguist-documentation
vite.config.ts linguist-documentation

# Backend folder is separate (keep as JavaScript)
backend/** linguist-language=JavaScript

# Documentation and config files
*.md linguist-documentation
*.json linguist-documentation
