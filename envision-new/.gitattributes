# TypeScript/React files (primary language)
*.ts linguist-language=TypeScript
*.tsx linguist-language=TSX
*.jsx linguist-language=JSX

# Mark as detectable
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.jsx linguist-detectable=true

# Exclude config files from language statistics
eslint.config.js linguist-vendored
postcss.config.js linguist-vendored
tailwind.config.js linguist-vendored
vite.config.ts linguist-vendored

# Exclude build artifacts and dependencies
dist/** linguist-generated
node_modules/** linguist-vendored

# Documentation files
*.md linguist-documentation
*.json linguist-data
LICENSE linguist-documentation
README.md linguist-documentation
